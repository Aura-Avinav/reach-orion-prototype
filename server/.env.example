# ========================================================
# AURA Studio MERN Server Security & Environment Config
# ========================================================

PORT=5000
NODE_ENV=development

# 1. MongoDB Connection String
# For Cloud Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/aura_agency?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/aura_agency

# 2. Admin Security Passkey (Protects lead inquiries from unauthorized access)
# MUST BE CHANGED IN PRODUCTION!
ADMIN_SECRET=aura_studio_founder_key_2026

# 3. CORS Allowed Origins (Comma-separated list in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,https://aurastudio.agency
